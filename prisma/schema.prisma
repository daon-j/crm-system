// 보험설계사 개인 CRM - Prisma 스키마
// learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Customer {
  id                String         @id @default(cuid())
  name              String
  gender            String? // 남/여
  residentNumber    String? // 주민등록번호 (민감정보 - 화면에는 마스킹해서 노출)
  birthDate         DateTime?
  phone             String?
  address           String?
  job               String?
  email             String?
  grade             String         @default("B") // A/B/C 등급
  marketingOptIn    Boolean        @default(false) // 마케팅성 문자 수신동의 여부
  mobileConsent     Boolean        @default(false) // 모바일동의 여부 - 동의해야 내부 시스템에서 고객정보 조회/가입설계 가능 (매우 중요)
  mobileConsentDate DateTime? // 모바일동의 일자 - 동의(Y)인 경우 필수
  memo              String? // 자유메모 (야구 좋아함, 아들 고3 등)
  batchId           String? // 월별 고객DB 소속 배치 (없을 수도 있음)
  batch             CustomerBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  referredById      String? // 이 고객을 소개해준 기존 고객 (없을 수도 있음)
  referredBy        Customer?      @relation("CustomerReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals         Customer[]     @relation("CustomerReferrals") // 이 고객이 소개한 고객들
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  familyMembers Family[]
  consultations Consultation[]
  contracts     Contract[]
  messages      Message[]
  events        CalendarEvent[]

  @@index([batchId])
  @@index([referredById])
}

// 월별로 전달받는 고객DB 리스트 (예: "2026년 5월DB")
model CustomerBatch {
  id        String     @id @default(cuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  customers Customer[]
}

model Family {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  relation   String // 배우자/자녀/부모님 등
  name       String?
  birthDate  DateTime?
  memo       String?

  @@index([customerId])
}

// 콜 상담 결과 유형 - 기본 5종 시드 + 사용자가 직접 추가 가능
model CallResultType {
  id                   String           @id @default(cuid())
  name                 String           @unique // 부재중/방문확정/보류/거절/가입완료 + 커스텀
  isDefault            Boolean          @default(false)
  messageTemplateId    String?
  messageTemplate      MessageTemplate? @relation(fields: [messageTemplateId], references: [id])
  createsCalendarEvent Boolean          @default(false) // 방문확정처럼 일정 자동생성 필요한지
  createdAt            DateTime         @default(now())

  consultations Consultation[]
}

model Consultation {
  id              String          @id @default(cuid())
  customerId      String
  customer        Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  content         String // 상담 내용
  resultTypeId    String?
  resultType      CallResultType? @relation(fields: [resultTypeId], references: [id])
  nextContactDate DateTime? // 다음 연락일 (재접촉 계산용)
  visitDate       DateTime? // 방문확정 시 방문 예정일시
  createdAt       DateTime        @default(now())

  @@index([customerId])
}

model MessageTemplate {
  id        String   @id @default(cuid())
  name      String
  body      String // {{고객명}} 등 변수 치환 텍스트
  category  String // 부재중/방문확정/생일/월간안부/만기알림/커스텀
  createdAt DateTime @default(now())

  callResultTypes CallResultType[]
  messages        Message[]
}

// 문자 발송함 - 대기중/발송완료
model Message {
  id           String           @id @default(cuid())
  customerId   String
  customer     Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  templateId   String?
  template     MessageTemplate? @relation(fields: [templateId], references: [id])
  content      String // 최종 문구 (수정 가능)
  status       String           @default("PENDING") // PENDING / SENT / CANCELED
  triggerType  String // MISSED_CALL / VISIT_CONFIRM / BIRTHDAY / MONTHLY / EXPIRY / CUSTOM
  scheduledFor DateTime? // 발송 예정일
  sentAt       DateTime?
  createdAt    DateTime         @default(now())

  @@index([customerId])
  @@index([status])
}

model Contract {
  id          String    @id @default(cuid())
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  insurer     String // 보험사
  productName String // 상품명
  category    String // 실손/암보험/운전자보험 등
  joinDate    DateTime
  expiryDate  DateTime?
  premium     Int? // 보험료
  status      String    @default("ACTIVE") // ACTIVE/EXPIRED/CANCELED
  source      String    @default("PRE_EXISTING") // PRE_EXISTING(기존 가입상품) / AGENT_SALE(설계사 신규체결)
  createdAt   DateTime  @default(now())

  @@index([customerId])
  @@index([expiryDate])
}

// 학습노트 - 정보미팅/오전교육 기록
model StudyNote {
  id        String   @id @default(cuid())
  date      DateTime
  category  String // MORNING_MEETING / MORNING_TRAINING / ETC
  title     String
  content   String
  tags      String? // 콤마구분 태그
  createdAt DateTime @default(now())

  @@index([date])
  @@index([category])
}

model CalendarEvent {
  id         String    @id @default(cuid())
  title      String
  type       String // VISIT/EXPIRY/BIRTHDAY/ROUTINE/CUSTOM
  status     String    @default("SCHEDULED") // SCHEDULED / CANCELED
  startAt    DateTime
  endAt      DateTime?
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  memo       String?
  companion  String? // 동반자 (예: 홍길동 멘토 동반)
  area       String? // 방문 지역/동 (예: 다산동)
  createdAt  DateTime  @default(now())

  changeLogs CalendarEventLog[]

  @@index([startAt])
  @@index([status])
}

// 범용 설정 저장 (key-value) - 대시보드 레이아웃 등
model AppSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

// 오늘 할일 체크리스트 - 중요도는 설계사가 직접 선택
model Todo {
  id        String   @id @default(cuid())
  content   String
  priority  String   @default("MEDIUM") // HIGH / MEDIUM / LOW
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// 방문/일정의 변경·취소 이력 (언제/무엇에서 무엇으로/왜 바뀌었는지)
model CalendarEventLog {
  id              String        @id @default(cuid())
  eventId         String
  event           CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  action          String // RESCHEDULED / CANCELED
  previousStartAt DateTime?
  newStartAt      DateTime?
  reason          String?
  createdAt       DateTime      @default(now())

  @@index([eventId])
}
